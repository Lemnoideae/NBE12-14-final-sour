# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_MODE: data source for local dev and `npm run build -- --mode campus-test`.
# Unset or "mock" uses fixtures; "api" calls the backend. Normal service builds always use the API and omit mock tools.
# `npm run dev:api` sets "api" through the committed .env.api, so local dev usually needs no value here.
# VITE_API_MODE="api"

# API_PROXY_TARGET: backend the dev and preview servers forward /api and /ws to. Dev-server only (no VITE_ prefix,
# so it never reaches the browser). Unset means http://localhost:8080.
# API_PROXY_TARGET="http://localhost:8080"

# VITE_TURNSTILE_SITEKEY: Cloudflare Turnstile sitekey for the bot check (SCRUM-121). Public value, not a secret.
# Leave unset to use Cloudflare's test sitekey (always passes). Never put the Turnstile secret in a VITE_ variable.
# VITE_TURNSTILE_SITEKEY=""
