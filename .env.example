# [필수] JWT HS256 서명 키, UTF-8 기준 32바이트 이상
# 생성: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# [선택] CORS 허용 origin, 쉼표로 구분. 주석 처리해 두면 기본값 http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Redis URL은 나중에 Redis 서버 운영 시 사용
REDIS_URL=

# [필수] 학교 이메일 암호화 키(AES-256-GCM), Base64로 인코딩한 32바이트
# 생성: openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=CHANGE_ME
# [필수] 이메일 조회용 해시 키(HMAC-SHA256), Base64로 인코딩한 32바이트 이상. 바꾸면 기존 회원을 이메일로 찾을 수 없다
# 생성: openssl rand -base64 32
EMAIL_HASH_KEY=CHANGE_ME

# [prod 필수, 로컬 선택] 인증 메일 SMTP. SPRING_MAIL_HOST가 없으면 로컬에서는 코드를 로그로 남기고, prod에서는 앱이 시작하지 않는다
# Gmail은 앱 비밀번호를 쓴다 (포트 587, STARTTLS는 application.yaml에서 켬)
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# [선택] 발신 주소. 비우면 SPRING_MAIL_USERNAME
# VERIFICATION_MAIL_FROM=

# [선택] 업로드한 파일을 내려주는 공개 주소(CloudFront). 프로필 이미지 URL 검사에 쓴다. 주석 처리해 두면 기본값 https://cdn.devcproject.cloud
# FILE_PUBLIC_BASE_URL=https://cdn.devcproject.cloud
